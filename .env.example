# Token du bot Discord (obligatoire)
DISCORD_TOKEN=

# ID du serveur Discord principal (obligatoire)
GUILD_ID=

# Mode dev (true/false) : en dev, les slash commands sont enregistrées
# sur le seul serveur GUILD_ID (instantané), sinon globalement (1h de délai)
DEV_MODE=true

# Dossier des données (roster, journaux de quêtes, caches).
#
# En conteneur, TOUT ce qui est écrit hors d'un volume monté disparaît au
# redémarrage. Sur Railway, monte un volume dans l'onglet Settings du service :
# la variable RAILWAY_VOLUME_MOUNT_PATH est alors injectée toute seule et le bot
# la suit, il n'y a rien à régler ici.
#
# Sur un autre hébergeur, indique ici le point de montage du volume.
# En local, laisser vide : le bot écrit dans ./data, qui persiste déjà.
DATA_DIR=

# Les chemins par fichier ci-dessous restent honorés s'ils sont renseignés,
# mais DATA_DIR les remplace tous et suffit dans la quasi-totalité des cas.
# MEMBERS_FILE_PATH=
# ALTS_FILE_PATH=
# GUILD_INFO_FILE_PATH=
# WOW_SEASON_FILE_PATH=
# HAUTS_FAITS_FILE_PATH=
# OBJECTIFS_FILE_PATH=

# API Blizzard : identifiants à créer sur https://develop.battle.net/access/clients
# Alimentent la veille : noms de donjons et d'extensions en français.
# Sans ces clés, /que-faire bascule sur des formulations génériques (pas de plantage).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=fr_FR

# OpenRouter : rédaction de la marche à suivre des objectifs personnalisés.
# Clé à créer sur https://openrouter.ai/keys
# Sans clé, /que-faire reste pleinement fonctionnel : les objectifs sont rendus
# avec des gabarits au lieu d'être rédigés. Les faits, eux, viennent toujours de
# l'API Blizzard, et l'IA ne choisit jamais la cible.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Canal Discord où féliciter un membre qui boucle son objectif (vide = désactivé)
OBJECTIFS_CHANNEL_ID=
